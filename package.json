{
  "name": "clocki",
  "version": "1.2.0",
  "description": "Minimal floating work timer overlay",
  "author": {
    "name": "Masih Moafi",
    "email": "hi@masihmoafi.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/MasihMoafi/clocki",
  "repository": {
    "type": "git",
    "url": "https://github.com/MasihMoafi/clocki.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron dist/main.js",
    "build": "tsc",
    "start": "electron dist/main.js",
    "snap": "npm run build && electron-builder --linux snap --publish never",
    "reset": "electron dist/main.js --reset",
    "dist": "npm run build && electron-builder --linux snap AppImage deb --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "^5.9.3"
  }
}
